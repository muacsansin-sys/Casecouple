rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      allow read, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        (
          resource.data.memberIds.size() < 2 &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.size() <= 2
        )
      );
    }

    match /couples/{coupleId}/{document=**} {
      allow read, write: if isCoupleMember(coupleId);
    }
  }
}